# ============================================
# Environment Configuration Template
# ============================================
# This file shows all available environment variables
# Copy to .env.local for local development overrides:
#   cp .env.example .env.local
#
# ⚠️  .env.local is git-ignored - safe for secrets
# ============================================

# ============================================
# 📁 Environment File Loading Order
# ============================================
# Next.js loads environment files in this priority (highest wins):
#
# 1. .env                           (all environments - rarely used)
# 2. .env.development               (development only - committed)
# 3. .env.production                (production only - template committed)
# 4. .env.local                     (local overrides - git-ignored)
# 5. .env.development.local         (local dev overrides - git-ignored)
# 6. .env.production.local          (local prod testing - git-ignored)
#
# Current setup:
# - Development: Uses .env.development (committed with dev store)
# - Production: Uses Vercel environment variables (not committed)
# - Local overrides: Use .env.local (git-ignored)
# ============================================

# ============================================
# 🛍️  Shopify Storefront API
# ============================================
# Get these from: Shopify Admin → Settings → Apps and sales channels
# → Develop apps → Your App → API credentials → Storefront API
#
# Pattern: SHOPIFY_{TENANT}_STORE_DOMAIN
#          SHOPIFY_{TENANT}_STOREFRONT_ACCESS_TOKEN

# Eonlife Store
SHOPIFY_EONLIFE_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_EONLIFE_STOREFRONT_ACCESS_TOKEN="your-access-token-here"

# Reluma Store (add when ready)
# SHOPIFY_RELUMA_STORE_DOMAIN="reluma-store.myshopify.com"
# SHOPIFY_RELUMA_STOREFRONT_ACCESS_TOKEN="your-access-token-here"

# 💡 TIP: Dev vs Prod stores
# - .env.development uses: eonlife-dev.myshopify.com
# - .env.production uses: eonlife.myshopify.com
# - Vercel Production env vars override .env.production

# ============================================
# 🗄️  Supabase (Database & Auth)
# ============================================
# Get these from: Supabase Dashboard → Project Settings → Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Public Supabase URL and Anon Key
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ============================================
# 💳 Stripe (Payment Processing)
# ============================================
# Get these from: Stripe Dashboard → Developers → API keys
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# For webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# 🏢 Multi-Tenant Configuration
# ============================================
# Default tenant shown when visiting root URL
NEXT_PUBLIC_DEFAULT_TENANT="eonlife"

# Comma-separated list of allowed tenants
NEXT_PUBLIC_ALLOWED_TENANTS="eonlife,reluma"

# ============================================
# 📦 Data Provider Toggle
# ============================================
# Controls where product data comes from
# Options:
#   "mock"    - Uses mock data (fast, no API calls)
#   "shopify" - Uses Shopify Storefront API
#   "custom"  - Uses custom provider
NEXT_PUBLIC_DATA_PROVIDER="shopify"

# ============================================
# 🌐 App Configuration
# ============================================
# Base URL of your application
# Development: http://localhost:3000
# Production:  https://eonlife.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API base URL (usually same as APP_URL)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ============================================
# 🎛️  Feature Flags
# ============================================
# Enable/disable features per environment

# Chatbot (n8n widget)
NEXT_PUBLIC_ENABLE_CHATBOT="true"

# Analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# ============================================
# 📊 Analytics (Optional)
# ============================================
# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Facebook Pixel
# NEXT_PUBLIC_FB_PIXEL_ID="your-pixel-id"

# ============================================
# 🔐 Authentication (Optional - Future)
# ============================================
# NextAuth.js secret
# NEXTAUTH_SECRET="your-nextauth-secret"
# NEXTAUTH_URL="http://localhost:3000"

# ============================================
# 📝 Notes for Team Members
# ============================================
# 1. Never commit .env.local - it's git-ignored for a reason
# 2. Use .env.development for safe dev defaults
# 3. Set production secrets in Vercel Dashboard, not in code
# 4. Run `npm run validate:env` to check your setup
# 5. Rotate Shopify tokens regularly for security
