# ============================================
# DEVELOPMENT ENVIRONMENT
# ============================================
# This file is loaded automatically when running:
# - npm run dev
# - npm run build (if NODE_ENV=development)
#
# Committed to Git - DO NOT put secrets here!
# Use .env.development.local for local overrides (git-ignored)
# ============================================

# ============================================
# Shopify Development Stores
# ============================================
# These point to your Shopify development/test stores

# Eonlife Development Store
SHOPIFY_EONLIFE_STORE_DOMAIN="eonlife-dev.myshopify.com"
SHOPIFY_EONLIFE_STOREFRONT_ACCESS_TOKEN="bdf633141b64a82134f2e5aa59cb0739"

# Reluma Development Store (add when ready)
# SHOPIFY_RELUMA_STORE_DOMAIN="reluma-dev.myshopify.com"
# SHOPIFY_RELUMA_STOREFRONT_ACCESS_TOKEN="your-dev-token-here"

# ============================================
# App Configuration
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DATA_PROVIDER="shopify"
NEXT_PUBLIC_DEFAULT_TENANT="eonlife"
NEXT_PUBLIC_ALLOWED_TENANTS="eonlife,reluma"

# ============================================
# Feature Flags (Development)
# ============================================
NEXT_PUBLIC_ENABLE_CHATBOT="true"
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
