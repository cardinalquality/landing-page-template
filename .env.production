# ============================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ============================================
# This file is loaded automatically when running:
# - npm run build (if NODE_ENV=production)
# - npm run start
#
# ⚠️  IMPORTANT: This is a TEMPLATE file committed to Git
# ⚠️  DO NOT put real production secrets here!
#
# Real production values should be set in:
# - Vercel Dashboard → Settings → Environment Variables → Production
# - Or .env.production.local for local testing (git-ignored)
# ============================================

# ============================================
# Shopify Production Stores
# ============================================
# Set these in Vercel Dashboard for production deployment

# Eonlife Production Store
SHOPIFY_EONLIFE_STORE_DOMAIN="eonlife-2.myshopify.com"
SHOPIFY_EONLIFE_STOREFRONT_ACCESS_TOKEN="set-in-vercel-dashboard"

# Reluma Production Store
# SHOPIFY_RELUMA_STORE_DOMAIN="reluma.myshopify.com"
# SHOPIFY_RELUMA_STOREFRONT_ACCESS_TOKEN="set-in-vercel-dashboard"

# ============================================
# App Configuration
# ============================================
# These should be set in Vercel as environment variables
NEXT_PUBLIC_APP_URL="https://eonlife.com"
NEXT_PUBLIC_DATA_PROVIDER="shopify"
NEXT_PUBLIC_DEFAULT_TENANT="eonlife"
NEXT_PUBLIC_ALLOWED_TENANTS="eonlife,reluma"

# ============================================
# Feature Flags (Production)
# ============================================
NEXT_PUBLIC_ENABLE_CHATBOT="true"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"

# ============================================
# Database (Production)
# ============================================
# Set these in Vercel Dashboard - DO NOT commit real values!
# DATABASE_URL="set-in-vercel-dashboard"
# DIRECT_URL="set-in-vercel-dashboard"

# ============================================
# Instructions for Setting Production Variables:
# ============================================
# 1. Go to Vercel Dashboard → Your Project → Settings → Environment Variables
# 2. Click "Add New"
# 3. Set Environment to "Production"
# 4. Add each variable with its real production value
# 5. Redeploy to apply changes
